    <style>
        .navbar-brand-box {
            display: flex;
            justify-content: space-between; /* Aligns items to both ends */
            align-items: center; /* Centers items vertically */
            margin-left: 0px;
            height: 80px; /* Set the height of the navbar */
        }

        .logo-background {
            background-color: white;
            display: inline-block;
            padding: 5px 10px; /* Horizontal padding for left and right sides */
            border-radius: 5px; /* Optional: Adds rounded corners */
            box-shadow: 0 0 3px rgba(0, 0, 0, 0.1); /* Optional: Adds a subtle shadow */
            height: 150%; /* Ensure the logo fits the height of the navbar */
            display: flex;
            align-items: center; /* Center the logo text or image vertically */
        }
    </style>


