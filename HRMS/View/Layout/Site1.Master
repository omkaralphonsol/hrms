                            <asp:Repeater ID="rptMainAndSubMenu" runat="server" OnItemDataBound="rptMainAndSubMenu_ItemDataBound">
                                <ItemTemplate>
                                    <li runat="server" visible='<%# !string.Equals((Eval("Menu") ?? "").ToString().Trim(), "Home", StringComparison.OrdinalIgnoreCase) && !((Eval("MenuLink") ?? "").ToString().ToLower().Contains("/view/modules/home.aspx")) %>'>
                                        <a href='<%#Eval("MenuLink").ToString() != "" ? Eval("MenuLink") : "javascript:void(0);"  %>' class='<%#Eval("MenuLink").ToString() != "" ?"" : "has-arrow waves-effect" %>'>
