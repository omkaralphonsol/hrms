                                                                    <a href='<%# (Eval("SubMenuLink") != null && !string.IsNullOrWhiteSpace(Eval("SubMenuLink").ToString())) ? Eval("SubMenuLink").ToString() : "/View/Modules/useruploaddocuments.aspx" %>' key="t-default">Upload Document</a>
                                                                </li>
                                                                <li>
