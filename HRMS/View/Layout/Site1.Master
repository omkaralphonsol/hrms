                                                            </ul>
                                                        </asp:PlaceHolder>
                                                        <asp:PlaceHolder runat="server" Visible='<%# !((Eval("SubMenu") ?? "").ToString().Trim().ToLower() == "document") && !((Eval("SubMenu") ?? "").ToString().Trim().ToLower() == "update probation period") %>'>
                                                            <asp:HyperLink ID="SubMenuLink" runat="server" Text='<%# Eval("SubMenu") %>' Key="t-default"
                                                                NavigateUrl='<%# (Eval("SubMenuLink") != null && !string.IsNullOrWhiteSpace(Eval("SubMenuLink").ToString())) ? Eval("SubMenuLink").ToString() : "" %>'>
                                                            </asp:HyperLink>
                                                        </asp:PlaceHolder>

